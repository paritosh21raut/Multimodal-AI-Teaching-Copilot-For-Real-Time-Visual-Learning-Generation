{"id": "s01", "genre": "science", "split": "dev", "familiar": true, "title": "Galileo and the leaning tower", "cast": {"galileo": {"kind": "person", "name": "Galileo", "known": "galileo"}, "stairs": {"kind": "prop", "name": "the stairs"}, "tower": {"kind": "place", "name": "the leaning tower of Pisa", "words": ["tower", "pisa"]}, "iron": {"kind": "prop", "name": "a heavy iron ball", "words": ["iron"]}, "wood": {"kind": "prop", "name": "a light wooden ball", "words": ["wooden"]}, "students": {"kind": "group", "name": "Students"}, "ground": {"kind": "place", "name": "the ground"}}, "lines": [{"text": "Galileo climbed the stairs of the leaning tower of Pisa.", "ev": [{"act": "climb", "by": "galileo", "to": "stairs"}], "rel": [["galileo", "in", "tower"]]}, {"text": "He carried a heavy iron ball and a light wooden ball.", "ev": [{"act": "carry", "by": "galileo", "obj": "iron"}, {"act": "carry", "by": "galileo", "obj": "wood"}], "rel": [["galileo", "hold", "iron"], ["galileo", "hold", "wood"]]}, {"text": "Students waited on the ground below to watch.", "ev": [{"act": "wait", "by": "students", "never": true}], "rel": [["students", "on", "ground"]]}, {"text": "At the top, Galileo leaned over the edge.", "ev": [{"act": "lean", "by": "galileo"}]}, {"text": "He let go of both balls at the same moment.", "ev": [{"act": "let_go", "by": "galileo", "to": "iron"}, {"act": "let_go", "by": "galileo", "to": "wood"}], "end": [["galileo", "hold", "iron"], ["galileo", "hold", "wood"]]}, {"text": "The two balls fell side by side through the air.", "ev": [{"act": "fall", "by": "iron", "to": "ground"}, {"act": "fall", "by": "wood", "to": "ground"}]}, {"text": "They hit the ground at the same time.", "ev": [], "rel": [["iron", "on", "ground"], ["wood", "on", "ground"]]}, {"text": "The students looked up in surprise.", "ev": [{"act": "look", "by": "students", "to": "galileo"}, {"act": "react", "by": "students", "val": "surprise"}]}, {"text": "Galileo shouted down, weight does not change how fast things fall.", "ev": [{"act": "shout", "by": "galileo", "to": "students"}]}]},
{"id": "s02", "genre": "science", "split": "dev", "familiar": false, "title": "The ice cube and the sun", "cast": {"ice": {"kind": "prop", "name": "A little ice cube", "words": ["ice", "cube"]}, "plate": {"kind": "prop", "name": "a plate"}, "table": {"kind": "prop", "name": "the kitchen table", "words": ["table"]}, "sun": {"kind": "agent", "name": "The sun"}, "puddle": {"kind": "prop", "name": "a small puddle of water", "words": ["puddle"]}, "asha": {"kind": "person", "name": "A girl named Asha", "gender": "she", "words": ["asha", "girl"]}, "mother": {"kind": "person", "name": "Her mother", "gender": "she"}, "sill": {"kind": "prop", "name": "the warm windowsill", "words": ["windowsill"]}}, "lines": [{"text": "A little ice cube sat on a plate on the kitchen table.", "ev": [], "rel": [["ice", "on", "plate"], ["plate", "on", "table"]]}, {"text": "The sun shone through the window onto the plate.", "ev": [{"act": "shine", "by": "sun", "to": "plate"}]}, {"text": "Slowly the ice cube melted into a small puddle of water.", "ev": [{"act": "melt", "by": "ice"}]}, {"text": "A girl named Asha looked at the puddle and asked, where did the ice go.", "ev": [{"act": "look", "by": "asha", "to": "puddle"}, {"act": "ask", "by": "asha"}]}, {"text": "Her mother said, it turned into water, and soon it will turn into vapour.", "ev": [{"act": "say", "by": "mother", "to": "asha"}]}, {"text": "Asha put the plate on the warm windowsill.", "ev": [{"act": "put", "by": "asha", "obj": "plate", "to": "sill"}], "rel": [["plate", "on", "sill"]]}, {"text": "By evening the puddle was gone.", "ev": [{"act": "evaporate", "by": "puddle"}]}, {"text": "Asha pointed at the empty plate and laughed.", "ev": [{"act": "point", "by": "asha", "to": "plate"}, {"act": "react", "by": "asha", "val": "happy"}]}]},
{"id": "s03", "genre": "science", "split": "val", "familiar": true, "title": "Archimedes in the bath", "cast": {"hiero": {"kind": "person", "name": "King Hiero", "gender": "he", "words": ["hiero", "king"]}, "archimedes": {"kind": "person", "name": "Archimedes", "known": "archimedes"}, "crown": {"kind": "prop", "name": "a golden crown"}, "home": {"kind": "place", "name": "home"}, "bath": {"kind": "prop", "name": "a bath full of water", "words": ["bath"], "noun": "bath"}, "water": {"kind": "agent", "name": "The water", "words": ["water"]}, "palace": {"kind": "place", "name": "the palace"}, "bowl": {"kind": "prop", "name": "a bowl of water", "words": ["bowl"]}, "goldsmith": {"kind": "person", "name": "the goldsmith"}}, "lines": [{"text": "King Hiero gave Archimedes a golden crown and a puzzle.", "ev": [{"act": "give", "by": "hiero", "obj": "crown", "to": "archimedes"}]}, {"text": "The king asked, is this crown made of pure gold.", "ev": [{"act": "ask", "by": "hiero", "to": "archimedes"}]}, {"text": "Archimedes took the crown home and thought for many days.", "ev": [{"act": "carry", "by": "archimedes", "obj": "crown"}, {"act": "go", "by": "archimedes", "to": "home"}, {"act": "react", "by": "archimedes", "val": "think"}]}, {"text": "One day he stepped into a bath full of water.", "ev": [{"act": "get_in", "by": "archimedes", "to": "bath"}], "rel": [["archimedes", "in", "bath"]]}, {"text": "The water rose and spilled over the edge.", "ev": [{"act": "overflow", "by": "water"}]}, {"text": "Archimedes jumped out of the bath and shouted, eureka.", "ev": [{"act": "jump", "by": "archimedes"}, {"act": "shout", "by": "archimedes"}], "end": [["archimedes", "in", "bath"]]}, {"text": "He ran through the streets to the palace.", "ev": [{"act": "run", "by": "archimedes", "to": "palace"}]}, {"text": "He put the crown in a bowl of water and measured the water that spilled.", "ev": [{"act": "put", "by": "archimedes", "obj": "crown", "to": "bowl"}, {"act": "measure", "by": "archimedes", "obj": "water"}], "rel": [["crown", "in", "bowl"]]}, {"text": "The crown pushed out more water than pure gold would.", "ev": [{"act": "compare", "by": "crown", "never": true}]}, {"text": "Archimedes showed the king that the goldsmith had cheated.", "ev": [{"act": "show", "by": "archimedes", "to": "hiero"}, {"act": "cheat", "by": "goldsmith", "never": true}]}]},
{"id": "s04", "genre": "science", "split": "val", "familiar": false, "title": "The two paper boats", "cast": {"leo": {"kind": "person", "name": "Leo"}, "mia": {"kind": "person", "name": "Mia"}, "pond": {"kind": "place", "name": "a pond"}, "leoboat": {"kind": "prop", "name": "his thin newspaper boat", "words": ["newspaper"]}, "miaboat": {"kind": "prop", "name": "her thick cardboard boat", "words": ["cardboard"]}, "wind": {"kind": "agent", "name": "A light wind"}, "side": {"kind": "place", "name": "the far side"}}, "lines": [{"text": "Two friends, Leo and Mia, sat by a pond with paper boats.", "ev": [{"act": "sit", "by": "leo"}, {"act": "sit", "by": "mia"}], "rel": [["leo", "next_to", "pond"], ["mia", "next_to", "pond"]]}, {"text": "Leo put his thin newspaper boat on the water.", "ev": [{"act": "put", "by": "leo", "obj": "leoboat", "to": "pond"}], "rel": [["leoboat", "on", "pond"]]}, {"text": "Mia put her thick cardboard boat next to it.", "ev": [{"act": "put", "by": "mia", "obj": "miaboat", "to": "pond"}], "rel": [["miaboat", "next_to", "leoboat"]]}, {"text": "A light wind pushed both boats across the pond.", "ev": [{"act": "push", "by": "wind", "obj": "leoboat"}, {"act": "push", "by": "wind", "obj": "miaboat"}]}, {"text": "Soon the newspaper boat got soggy and began to sink.", "ev": [{"act": "sink", "by": "leoboat"}]}, {"text": "Leo knelt by the water and lifted it out.", "ev": [{"act": "kneel", "by": "leo"}, {"act": "pick_up", "by": "leo", "obj": "leoboat"}]}, {"text": "Mia's boat kept floating to the far side.", "ev": [{"act": "float", "by": "miaboat", "to": "side"}]}, {"text": "Mia ran around the pond to catch her boat.", "ev": [{"act": "run", "by": "mia"}, {"act": "catch", "by": "mia", "obj": "miaboat"}]}, {"text": "Leo said, thick card soaks up water more slowly.", "ev": [{"act": "say", "by": "leo", "to": "mia"}]}, {"text": "Mia held up her boat and nodded.", "ev": [{"act": "lift", "by": "mia", "obj": "miaboat"}, {"act": "nod", "by": "mia"}]}]},
{"id": "s05", "genre": "science", "split": "test", "familiar": true, "title": "Fleming and the mould", "cast": {"fleming": {"kind": "person", "name": "Alexander Fleming", "words": ["fleming", "alexander"]}, "lab": {"kind": "place", "name": "a small messy laboratory", "words": ["laboratory", "lab"]}, "dishes": {"kind": "prop", "name": "some dishes of germs", "words": ["dishes", "dish"], "split_ok": true}, "bench": {"kind": "prop", "name": "the bench"}, "door": {"kind": "prop", "name": "the door"}, "mould": {"kind": "agent", "name": "A green mould"}, "assistant": {"kind": "person", "name": "his assistant"}, "microscope": {"kind": "prop", "name": "a microscope"}}, "lines": [{"text": "Alexander Fleming worked in a small messy laboratory.", "ev": [{"act": "work", "by": "fleming"}], "rel": [["fleming", "in", "lab"]]}, {"text": "Before his holiday he left some dishes of germs on the bench.", "ev": [{"act": "put", "by": "fleming", "obj": "dishes", "to": "bench"}], "rel": [["dishes", "on", "bench"]]}, {"text": "He locked the door and went away for two weeks.", "ev": [{"act": "close", "by": "fleming", "obj": "door"}, {"act": "leave", "by": "fleming", "to": "lab"}]}, {"text": "When he came back, he picked up one of the dishes.", "ev": [{"act": "arrive", "by": "fleming"}, {"act": "pick_up", "by": "fleming", "obj": "dishes"}]}, {"text": "A green mould was growing on it.", "ev": [{"act": "grow", "by": "mould"}], "rel": [["mould", "on", "dishes"]]}, {"text": "Around the mould, the germs had died.", "ev": [{"act": "die", "by": "dishes", "never": true}]}, {"text": "Fleming held the dish up to the light and looked closely.", "ev": [{"act": "lift", "by": "fleming", "obj": "dishes"}, {"act": "look", "by": "fleming", "to": "dishes"}]}, {"text": "He called to his assistant, look at this, that's funny.", "ev": [{"act": "say", "by": "fleming", "to": "assistant"}]}, {"text": "The assistant walked over and looked through a microscope.", "ev": [{"act": "walk", "by": "assistant", "to": "fleming"}, {"act": "look", "by": "assistant", "to": "microscope"}]}]},
{"id": "s06", "genre": "science", "split": "test", "familiar": false, "title": "The plant that found the light", "cast": {"sam": {"kind": "person", "name": "A boy named Sam", "gender": "he", "words": ["sam", "boy"]}, "seed": {"kind": "prop", "name": "a bean seed", "words": ["seed", "bean"]}, "pot": {"kind": "prop", "name": "a pot"}, "cupboard": {"kind": "prop", "name": "a dark cupboard", "words": ["cupboard"]}, "hole": {"kind": "prop", "name": "a small hole"}, "shoot": {"kind": "agent", "name": "a tiny green shoot", "words": ["shoot", "plant"]}, "nina": {"kind": "person", "name": "Sam's sister Nina", "gender": "she", "words": ["nina", "sister"]}, "window": {"kind": "place", "name": "the sunny window", "words": ["window"]}}, "lines": [{"text": "A boy named Sam planted a bean seed in a pot.", "ev": [{"act": "plant", "by": "sam", "obj": "seed", "to": "pot"}], "rel": [["seed", "in", "pot"]]}, {"text": "He put the pot in a dark cupboard with a small hole on one side.", "ev": [{"act": "put", "by": "sam", "obj": "pot", "to": "cupboard"}], "rel": [["pot", "in", "cupboard"]]}, {"text": "Every day Sam opened the cupboard and watered the seed.", "ev": [{"act": "open", "by": "sam", "obj": "cupboard"}, {"act": "pour", "by": "sam", "obj": "seed"}]}, {"text": "After a week a tiny green shoot came out of the soil.", "ev": [{"act": "grow", "by": "shoot"}]}, {"text": "The shoot bent and grew towards the hole.", "ev": [{"act": "grow", "by": "shoot", "to": "hole"}], "rel": [["shoot", "towards", "hole"]]}, {"text": "Sam's sister Nina looked inside and asked, why is it growing sideways.", "ev": [{"act": "look", "by": "nina", "to": "cupboard"}, {"act": "ask", "by": "nina", "to": "sam"}]}, {"text": "Sam said, it is looking for the light.", "ev": [{"act": "say", "by": "sam", "to": "nina"}]}, {"text": "They moved the pot to the sunny window.", "ev": [{"act": "carry", "by": "sam", "obj": "pot"}, {"act": "walk", "by": "sam", "to": "window"}], "rel": [["pot", "next_to", "window"]]}, {"text": "In a few days the plant stood straight up.", "ev": [{"act": "straighten", "by": "shoot"}]}]},
{"id": "s07", "genre": "science", "split": "test", "familiar": true, "title": "Marie Curie and the glowing jars", "cast": {"curie": {"kind": "person", "name": "Marie Curie", "known": "curie", "words": ["curie", "marie"]}, "pierre": {"kind": "person", "name": "her husband Pierre", "gender": "he", "words": ["pierre", "husband"]}, "shed": {"kind": "place", "name": "an old wooden shed", "words": ["shed"]}, "pot": {"kind": "prop", "name": "a huge pot of boiling rock", "words": ["pot"]}, "sacks": {"kind": "prop", "name": "heavy sacks of rock", "words": ["sacks"]}, "door": {"kind": "prop", "name": "the door"}, "jars": {"kind": "prop", "name": "Small glass jars", "words": ["jars"]}, "shelves": {"kind": "prop", "name": "the shelves"}}, "lines": [{"text": "Marie Curie and her husband Pierre worked in an old wooden shed.", "ev": [{"act": "work", "by": "curie"}, {"act": "work", "by": "pierre"}], "rel": [["curie", "in", "shed"], ["pierre", "in", "shed"]]}, {"text": "Every day Marie stirred a huge pot of boiling rock.", "ev": [{"act": "work", "by": "curie", "to": "pot"}]}, {"text": "Pierre carried heavy sacks of rock into the shed.", "ev": [{"act": "carry", "by": "pierre", "obj": "sacks"}, {"act": "enter", "by": "pierre", "to": "shed"}], "rel": [["pierre", "hold", "sacks"]]}, {"text": "After four years they had a tiny amount of a new element.", "ev": [{"act": "discover", "by": "curie", "never": true}]}, {"text": "One night they walked back to the shed in the dark.", "ev": [{"act": "walk", "by": "curie", "to": "shed"}, {"act": "walk", "by": "pierre", "to": "shed"}]}, {"text": "They opened the door and stood still.", "ev": [{"act": "open", "by": "curie", "obj": "door"}, {"act": "stand", "by": "curie"}, {"act": "stand", "by": "pierre"}]}, {"text": "Small glass jars on the shelves were glowing with a soft blue light.", "ev": [{"act": "glow", "by": "jars"}], "rel": [["jars", "on", "shelves"]]}, {"text": "Marie held Pierre's hand and smiled.", "ev": [{"act": "hold", "by": "curie", "obj": "pierre"}, {"act": "react", "by": "curie", "val": "happy"}]}, {"text": "Pierre whispered, it is beautiful.", "ev": [{"act": "say", "by": "pierre", "to": "curie"}]}]},
{"id": "s08", "genre": "science", "split": "test", "familiar": false, "title": "The journey of a water drop", "cast": {"drop": {"kind": "agent", "name": "A tiny drop of water", "words": ["drop"]}, "sea": {"kind": "place", "name": "the sea"}, "sun": {"kind": "agent", "name": "The hot sun", "words": ["sun"]}, "sky": {"kind": "place", "name": "the sky"}, "cloud": {"kind": "agent", "name": "a grey cloud", "words": ["cloud"]}, "drops": {"kind": "group", "name": "other drops", "words": ["drops"]}, "mountains": {"kind": "place", "name": "the mountains"}, "hillside": {"kind": "place", "name": "a hillside"}, "stream": {"kind": "place", "name": "a small stream", "words": ["stream"]}}, "lines": [{"text": "A tiny drop of water lived in the sea.", "ev": [], "rel": [["drop", "in", "sea"]]}, {"text": "The hot sun warmed the sea all morning.", "ev": [{"act": "shine", "by": "sun", "to": "sea"}]}, {"text": "The drop became light and floated up into the sky as vapour.", "ev": [{"act": "float", "by": "drop", "to": "sky"}], "rel": [["drop", "in", "sky"]]}, {"text": "High above, it joined other drops in a grey cloud.", "ev": [{"act": "join", "by": "drop", "to": "cloud"}], "rel": [["drop", "in", "cloud"], ["drops", "in", "cloud"]]}, {"text": "The cloud drifted over the mountains.", "ev": [{"act": "go", "by": "cloud", "to": "mountains"}], "rel": [["cloud", "above", "mountains"]]}, {"text": "It grew cold and the drop fell as rain onto a hillside.", "ev": [{"act": "fall", "by": "drop", "to": "hillside"}]}, {"text": "The drop rolled down the hill into a small stream.", "ev": [{"act": "roll", "by": "drop", "to": "stream"}], "rel": [["drop", "in", "stream"]]}, {"text": "The stream carried it all the way back to the sea.", "ev": [{"act": "flow", "by": "drop", "to": "sea"}]}, {"text": "And so the journey of the drop began again.", "ev": [{"act": "repeat", "by": "drop", "never": true}]}]}
