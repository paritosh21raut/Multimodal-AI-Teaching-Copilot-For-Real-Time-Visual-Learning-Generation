# ==========================================================
# LLM PROVIDER (Phase 1 — Groq)
# ==========================================================

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Leave LLM_BASE_URL empty to use Groq SDK default
# (https://api.groq.com/openai/v1).
LLM_BASE_URL=

LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_REASONING_EFFORT=medium


# ==========================================================
# GROQ
# ==========================================================

# Required. Do NOT commit the real value.
GROQ_API_KEY=your_groq_api_key_here